{
  "name": "workshub",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "workshub_library", "database_id": "5590e4eb-2858-4b2f-8a39-016d308d60a9" }
  ]
}
